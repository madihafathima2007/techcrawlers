
Project Nexora {
  database_type: 'PostgreSQL'
  Note: 'Shared database for the Creator Workspace and Agency Workspace'
}

// ==========================================
// 1. ENUMS - STANDARD STATUS VALUES
// ==========================================

Enum account_status {
  active
  pending
  suspended
}

Enum agency_member_role {
  admin
  campaign_manager
  finance_manager
  viewer
}

Enum creator_agency_status {
  invited
  active
  paused
  ended
}

Enum client_status {
  active
  inactive
  archived
}

Enum campaign_status {
  draft
  active
  paused
  completed
  cancelled
}

Enum assignment_status {
  invited
  accepted
  declined
  in_progress
  submitted
  completed
  cancelled
}

Enum deliverable_status {
  pending
  in_progress
  submitted
  changes_requested
  approved
  rejected
}

Enum content_status {
  idea
  planned
  in_progress
  ready
  scheduled
  published
  archived
}

Enum payment_status {
  pending
  processing
  paid
  overdue
  failed
  cancelled
}

Enum payment_direction {
  brand_to_agency
  agency_to_creator
}

Enum social_platform {
  instagram
  youtube
  tiktok
  facebook
  linkedin
  x
  other
}

Enum review_side {
  creator
  brand
}

Enum review_status {
  published
  pending_moderation
  hidden
}

// ==========================================
// 2. USER MANAGEMENT
// Shared identity for both workspaces
// ==========================================

Table users {
  id int [pk, increment]
  full_name varchar(120) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  profile_image_url varchar(500)
  account_status account_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// ==========================================
// 3. CREATOR WORKSPACE
// ==========================================

Table creator_profiles {
  id int [pk, increment]
  user_id int [not null, unique, ref: > users.id]
  display_name varchar(120) [not null]
  bio text
  primary_niche varchar(100)
  location varchar(120)
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 4. AGENCY WORKSPACE
// ==========================================

Table agencies {
  id int [pk, increment]
  name varchar(150) [not null]
  owner_user_id int [not null, ref: > users.id]
  business_email varchar(255)
  website varchar(255)
  created_at timestamp [not null, default: `now()`]
}

Table agency_members {
  id int [pk, increment]
  agency_id int [not null, ref: > agencies.id]
  user_id int [not null, ref: > users.id]
  role agency_member_role [not null, default: 'viewer']
  joined_at timestamp [default: `now()`]

  indexes {
    (agency_id, user_id) [unique]
  }
}

// Connects agencies with their creator portfolios

Table agency_creators {
  id int [pk, increment]
  agency_id int [not null, ref: > agencies.id]
  creator_profile_id int [not null, ref: > creator_profiles.id]
  status creator_agency_status [not null, default: 'invited']
  invited_at timestamp [default: `now()`]
  joined_at timestamp

  indexes {
    (agency_id, creator_profile_id) [unique]
  }
}

// ==========================================
// 5. BRAND CLIENT MANAGEMENT
// ==========================================

Table brand_clients {
  id int [pk, increment]
  agency_id int [not null, ref: > agencies.id]
  brand_name varchar(150) [not null]
  industry varchar(100)
  contact_person varchar(120)
  contact_email varchar(255)
  website varchar(255)

  // Optional login for verified brand reviews.
  // Does not create a separate full workspace.

  account_user_id int [unique, ref: > users.id]

  status client_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 6. CAMPAIGN MANAGEMENT
// ==========================================

Table campaigns {
  id int [pk, increment]
  agency_id int [not null, ref: > agencies.id]
  brand_client_id int [not null, ref: > brand_clients.id]
  created_by_user_id int [not null, ref: > users.id]

  title varchar(180) [not null]
  description text
  objective text
  target_audience text
  primary_platform social_platform

  budget decimal(12,2)
  currency char(3) [default: 'INR']

  start_date date
  end_date date
  status campaign_status [not null, default: 'draft']

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// Connects individual creators to campaigns

Table campaign_creators {
  id int [pk, increment]
  campaign_id int [not null, ref: > campaigns.id]
  creator_profile_id int [not null, ref: > creator_profiles.id]

  status assignment_status [not null, default: 'invited']
  agreed_fee decimal(12,2)
  currency char(3) [default: 'INR']

  invited_at timestamp [default: `now()`]
  accepted_at timestamp
  completed_at timestamp

  indexes {
    (campaign_id, creator_profile_id) [unique]
  }
}

// ==========================================
// 7. DELIVERABLE AND APPROVAL MANAGEMENT
// ==========================================

Table deliverables {
  id int [pk, increment]
  campaign_creator_id int [not null, ref: > campaign_creators.id]

  title varchar(180) [not null]
  description text
  content_format varchar(80)

  due_at timestamp
  submitted_url varchar(500)
  submission_notes text
  feedback text

  status deliverable_status [not null, default: 'pending']

  submitted_at timestamp
  approved_at timestamp
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 8. FINANCIAL MANAGEMENT
// Supports brand payments and creator payouts
// ==========================================

Table payments {
  id int [pk, increment]
  campaign_id int [not null, ref: > campaigns.id]

  // Optional for brand-to-agency payments.
  // Required for agency-to-creator payouts.

  campaign_creator_id int [ref: > campaign_creators.id]

  direction payment_direction [not null]
  amount decimal(12,2) [not null]
  currency char(3) [not null, default: 'INR']

  status payment_status [not null, default: 'pending']

  due_date date
  paid_at timestamp
  transaction_reference varchar(150)
  notes text

  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 9. AI CONTENT IDEA GENERATION
// ==========================================

Table content_ideas {
  id int [pk, increment]
  creator_profile_id int [not null, ref: > creator_profiles.id]

  topic varchar(180)
  target_audience text
  platform social_platform

  generated_title varchar(200)
  suggested_hook text
  caption_suggestion text

  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 10. CREATOR CONTENT PLANNING
// ==========================================

Table content_plans {
  id int [pk, increment]
  creator_profile_id int [not null, ref: > creator_profiles.id]

  // Optional link to a brand campaign.
  campaign_creator_id int [ref: > campaign_creators.id]

  // Optional link to an AI-generated idea.
  content_idea_id int [ref: > content_ideas.id]

  title varchar(180) [not null]
  content_type varchar(80)
  platform social_platform
  caption_draft text
  scheduled_at timestamp

  status content_status [not null, default: 'idea']
  published_url varchar(500)

  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 11. SOCIAL MEDIA ACCOUNT MANAGEMENT
// ==========================================

Table social_accounts {
  id int [pk, increment]
  creator_profile_id int [not null, ref: > creator_profiles.id]

  platform social_platform [not null]
  handle varchar(120) [not null]
  profile_url varchar(500)

  follower_count bigint [default: 0]
  is_verified boolean [default: false]

  connected_at timestamp [default: `now()`]
  last_synced_at timestamp

  indexes {
    (creator_profile_id, platform, handle) [unique]
  }
}

// ==========================================
// 12. SOCIAL MEDIA ANALYTICS HISTORY
// ==========================================

Table social_account_metrics {
  id int [pk, increment]
  social_account_id int [not null, ref: > social_accounts.id]

  followers_count bigint
  following_count bigint
  total_posts int

  engagement_rate decimal(6,3)
  average_likes bigint
  average_comments bigint
  reach bigint

  recorded_at timestamp [not null, default: `now()`]

  indexes {
    (social_account_id, recorded_at)
  }
}

// ==========================================
// 13. TWO-WAY COLLABORATION REVIEW SYSTEM
// Reviews are linked to verified campaign assignments
// ==========================================

Table reviews {
  id int [pk, increment]
  campaign_creator_id int [not null, ref: > campaign_creators.id]

  reviewer_user_id int [not null, ref: > users.id]
  reviewer_side review_side [not null]

  rating int [not null]
  review_text text

  status review_status [not null, default: 'pending_moderation']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (campaign_creator_id, reviewer_side) [unique]
  }
}

